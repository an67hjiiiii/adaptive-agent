{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PILOT-LIVE-WINDOW-V1",
  "title": "Pilot live execution window",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "window_id",
    "timezone",
    "not_before",
    "not_after",
    "max_duration",
    "authorization_scope",
    "status"
  ],
  "properties": {
    "schema_id": {"const": "PILOT-LIVE-WINDOW-V1"},
    "schema_version": {"const": "1.0"},
    "window_id": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "not_before": {"type": "string", "format": "date-time"},
    "not_after": {"type": "string", "format": "date-time"},
    "max_duration": {"type": "integer", "minimum": 1, "default": 14400},
    "authorization_scope": {"const": "AUTHORIZE_PILOT_EXECUTION"},
    "status": {"enum": ["SCHEDULED", "ACTIVE", "EXPIRED", "CANCELLED"]}
  }
}
