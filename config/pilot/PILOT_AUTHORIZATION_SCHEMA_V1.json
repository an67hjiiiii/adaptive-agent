{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PILOT-AUTHORIZATION-V1",
  "title": "Pilot owner authorization mechanism record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "authorization_id",
    "role",
    "authorized_scope",
    "manifest_id",
    "freeze_candidate_id",
    "preflight_id",
    "window_id",
    "timestamp",
    "status"
  ],
  "properties": {
    "schema_id": {"const": "PILOT-AUTHORIZATION-V1"},
    "schema_version": {"const": "1.0"},
    "authorization_id": {"type": "string", "minLength": 1},
    "role": {"const": "PROJECT_OWNER"},
    "authorized_scope": {"const": "AUTHORIZE_PILOT_EXECUTION"},
    "manifest_id": {"type": "string", "minLength": 1},
    "freeze_candidate_id": {"type": "string", "minLength": 1},
    "freeze/candidate_id": {"type": "string", "minLength": 1},
    "preflight_id": {"type": "string", "minLength": 1},
    "window_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PENDING", "AUTHORIZED", "REVOKED", "EXPIRED"]}
  }
}
