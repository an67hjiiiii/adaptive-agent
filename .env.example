# Provider used by default when its API key is configured.
# fake | gemini | groq | openrouter | openai
DEFAULT_PROVIDER=fake

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=Adaptive Agent Lab
OPENROUTER_APP_URL=http://127.0.0.1:8000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

MAX_LOGICAL_CALLS=12
MAX_PHYSICAL_REQUESTS=18
MAX_WORKERS=3
MAX_ESCALATIONS=1
MAX_RETRIES_PER_CALL=1
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30
CALL_TIMEOUT_SECONDS=60
